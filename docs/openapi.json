  "components": {
    "schemas": {
      "CollectRunRequest": {
        "properties": {
          "tickers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Tickers",
            "description": "Tickers to collect, e.g. ['DEMO-HK-001']"
          },
          "source": {
            "type": "string",
            "enum": [
              "all",
              "social",
              "news"
            ],
            "title": "Source",
            "description": "Which collector sources",
            "default": "all"
          },
          "label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Label",
            "description": "Optional human-readable label"
          }
        },
        "type": "object",
        "required": [
          "tickers"
        ],
        "title": "CollectRunRequest",
        "description": "POST /api/collect/run \u2014 persist a collection job (executed in Phase 7)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TrainRequest": {
        "properties": {
          "tickers": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tickers",
            "description": "Tickers in training scope; all if omitted"
          },
          "model_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name",
            "description": "Model version name"
          }
        },
        "type": "object",
        "title": "TrainRequest",
        "description": "POST /api/models/train \u2014 persist a training job (executed in Phase 8)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}