# ============================================================================
# AI Stock Sentiment Agent — environment template
# Copy to .env and fill in. .env is git-ignored and never enters Docker images.
# Real environment variables always override .env values.
# ============================================================================

# --- PostgreSQL (dev defaults suit the laptop; Compose overrides host/port) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5437
POSTGRES_USER=stock
POSTGRES_PASSWORD=stock_dev_password
POSTGRES_DB=stock_sentiment
# Full-URL override (optional). When set, the parts above are ignored.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/stock_sentiment

# --- Data mode: explicit setting, safe default "demo". Never inferred. ---
DATA_MODE=demo

# --- API security ---
# Admin key for /api admin endpoints (X-API-Key). Leave empty to disable admin.
API_ADMIN_KEY=

# --- Search / news providers (classified as search/news, NOT market data) ---
EXA_API_KEY=
TAVILY_API_KEY=

# --- Social collectors (Apify) ---
# APIFY_API_TOKEN is the single canonical credential name (used in Render and
# the local .env). Leave empty to disable social collection.
APIFY_API_TOKEN=

# --- Provider collection operations (Phase 5; safe defaults shown) ---
# Left empty to use the defaults. Set to override.
# PROVIDER_TIMEOUT_SECONDS=30
# PROVIDER_MAX_RETRIES=3
# PROVIDER_RETRY_BASE_DELAY_SECONDS=0.5
# PROVIDER_RETRY_BACKOFF_FACTOR=2.0
# PROVIDER_RETRY_MAX_DELAY_SECONDS=30
# PROVIDER_BATCH_LIMIT=120
# COLLECTION_WINDOW_DAYS=10

# --- Market data provider. Interface only in Phase 1; no vendor implementation.
#     Owner-selected default: Twelve Data. Leave MARKET_DATA_PROVIDER empty until
#     you activate a vendor; set it to "twelve_data" and provide the key to enable.
#     Vendor capabilities/symbol coverage remain UNVERIFIED until a Phase 5 live fetch.
# ---
MARKET_DATA_PROVIDER=
# TWELVE_DATA_API_KEY=

# --- Phase 14: market-data fallback + social actor refs + ML determinism ---
# Keyless yfinance fallback appended behind the primary provider. "yfinance"
# by default; set to "" to disable. Vendor coverage/ToS UNVERIFIED until a
# live fetch. Bars fetched this way are stored under provider="yfinance".
# MARKET_DATA_FALLBACK=yfinance
#
# Apify actor refs (owner-supplied; use the CANONICAL unique Actor ID, not the
# "namespace/name" tilde form — tilde refs 404 on POST /runs). These defaults
# live in app/core/config.py; set here only to override.
#   APIFY_ACTOR refs, one per source:
# APIFY_ACTOR_TELEGRAM=kCdMrRb7UiSRSFYeO   # lofomachines~telegram-keyword-search-scraper
# APIFY_ACTOR_NAVER=xxFbG2oX6UpaPtcTC      # hgservices~naver-stock-discussion-scraper
# APIFY_ACTOR_DAUM=Nb4IPtZTzc2RtuH7S       # ardent_fork~daum-news (KRX news)
# APIFY_ACTOR_HKGOLDEN=fSZMN7Wfwuye4J8cd   # claude_code_reviewer~hkgolden-scraper
#
# ML determinism + out-of-sample rigor. Fixed random seed; strict
# chronological holdout after the walk-forward CV (fraction of the tail).
# ML_RANDOM_SEED=42
# ML_HOLDOUT_RATIO=0.2

# --- CORS: explicit comma-separated origin list. Never "*". ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
